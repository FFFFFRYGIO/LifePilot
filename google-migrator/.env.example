# Copy to .env and fill in. Never commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000
DATABASE_URL=postgres://migrator:migrator@localhost:55433/migrator

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Entra ID app: "Personal Microsoft accounts only", platform Web,
# redirect URI {BASE_URL}/oauth/microsoft/callback, delegated Tasks.Read + User.Read.
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Google Cloud OAuth client (Web application),
# redirect URI {BASE_URL}/oauth/google/callback, Google Tasks API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- birthdays feature ---
# Source list in Microsoft To Do, target calendar/task-list name in Google.
BIRTHDAY_SOURCE_LIST=Urodziny
BIRTHDAY_CALENDAR_NAME=Urodziny
# Comma-separated; these accounts get the calendar shared with them.
BIRTHDAY_SHARE_WITH=
# reader | writer | owner
BIRTHDAY_SHARE_ROLE=writer
